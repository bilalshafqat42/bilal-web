{
  "name": "portfolio-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "warm": "node scripts/warm-images.mjs",
    "image-variants": "node scripts/image-variants.mjs",
    "image-check": "node scripts/image-variants-check.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "search-check": "tsx scripts/search-check.mjs",
    "related-check": "tsx scripts/related-check.mjs",
    "lead-options-check": "tsx scripts/lead-options-check.mjs",
    "h1-check": "node scripts/h1-check.mjs",
    "schema-check": "node scripts/schema-check.mjs",
    "lead-probe": "if curl -s -o /dev/null http://localhost:3099/; then echo 'Port 3099 is already serving; stop that server first.'; exit 1; fi; export LEAD_BACKUP_DIR=$(mktemp -d) SMTP_HOST= SMTP_USER= SMTP_PASS= CRM_LEAD_API_URL=http://127.0.0.1:9/blackhole; next start -p 3099 & pid=$!; trap 'pkill -P $pid 2>/dev/null; kill $pid 2>/dev/null' EXIT; for i in $(seq 1 40); do curl -sf -o /dev/null http://localhost:3099/ && break; sleep 1; done; BASE_URL=http://localhost:3099 node scripts/lead-probe.mjs",
    "discipline-check": "node scripts/discipline-check.mjs",
    "onpage": "node scripts/onpage-check.mjs",
    "audit": "node scripts/site-audit.mjs",
    "serp": "node scripts/serp-preview.mjs",
    "daily": "node scripts/daily.mjs",
    "cards": "node scripts/post-cards.mjs && node scripts/render-cards.mjs",
    "replay-leads": "node scripts/replay-leads.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lucide-react": "1.49.0",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  },
  "browserslist": [
    "chrome >= 111",
    "safari >= 16.4",
    "firefox >= 121",
    "edge >= 111"
  ]
}
