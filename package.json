    "lead-probe": "CRM_LEAD_API_URL=http://127.0.0.1:9/blackhole npx next start -p 3099 & for i in $(seq 1 40); do curl -sf -o /dev/null http://localhost:3099/ && break; sleep 1; done; CRM_LEAD_API_URL=http://127.0.0.1:9/blackhole BASE_URL=http://localhost:3099 node scripts/lead-probe.mjs; code=$?; kill %1 2>/dev/null; exit $code"
  },
