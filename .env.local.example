# The lead form popup posts to /api/lead, which forwards submissions to your CRM.
# These stay server-only (no NEXT_PUBLIC_ prefix) so the key never reaches the browser.
# Copy this file to .env.local and fill in your CRM's details. Restart `npm run dev` after adding it.

# Your CRM's endpoint that accepts a new lead (e.g. https://your-crm.com/api/leads)
CRM_LEAD_API_URL=

# Sent as: Authorization: Bearer <value>. Leave blank if your CRM endpoint doesn't need auth.
CRM_LEAD_API_KEY=
