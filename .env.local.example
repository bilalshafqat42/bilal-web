# The contact-page form, the lead popup and the WhatsApp chat all post to
# /api/lead, which forwards submissions to your app / CRM.
# These stay server-only (no NEXT_PUBLIC_ prefix) so the key never reaches the browser.
# Copy this file to .env.local and fill in your CRM's details. Restart `npm run dev` after adding it.

# Performo's public lead-intake endpoint for this company (Bilal Shafqat
# Digital), e.g. https://performo.vercel.app/api/public/submissions
CRM_LEAD_API_URL=

# Sent as the x-api-key header (Performo's contract, not Authorization:
# Bearer) — from Company Settings -> Website Lead Capture Integration
# in Performo, logged in as Bilal Shafqat Digital.
CRM_LEAD_API_KEY=

# Field names sent to CRM_LEAD_API_URL (JSON POST), mapped in
# src/app/api/lead/route.ts to match Performo's /api/public/submissions:
#   type ("form" or "chat"), name, email, phone, message, service, campaign,
#   pageUrl, utmSource, utmMedium, utmCampaign, utmContent, utmTerm
# `source` (contact-page-form / whatsapp-chat / whatsapp-chat-skip) decides
# whether `type` is "form" or "chat".

# --- Analytics (optional; nothing loads without it) ---
# Google Tag Manager container ID, e.g. GTM-XXXXXXX. NEXT_PUBLIC_ because it has
# to run in the browser. Put GA4, the Meta pixel, LinkedIn and TikTok tags INSIDE
# the container — that way new tracking never needs a code change or redeploy.
#
# The site pushes these events to the dataLayer for you to build triggers on:
#   generate_lead   — a lead confirmed as delivered to Performo.
#                     params: lead_source (contact-page-form | website-popup |
#                     whatsapp-chat), lead_service
#   whatsapp_click  — an outbound WhatsApp click.
#                     params: whatsapp_context
#
# Consent Mode v2 is wired up: all storage defaults to "denied" and flips to
# "granted" only when the visitor accepts the cookie banner.
NEXT_PUBLIC_GTM_ID=

# --- Google Search Console (optional) ---
# Search Console > Settings > Ownership verification > HTML tag.
# Copy ONLY the token from content="..." , not the whole tag.
# Set this on Hostinger too, or the tag will be missing in production.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Bing Webmaster Tools (optional) ---
# Bing > Settings > Verify ownership > "Meta tag". Copy ONLY the content value.
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- IndexNow ---
# Already generated and committed as public/cfc44ddc83791ced09cff999b9915876.txt.
# Change both together if it is ever rotated.
INDEXNOW_KEY=cfc44ddc83791ced09cff999b9915876

# --- AI assistant (optional; the Ask section hides its errors gracefully without it) ---
# console.anthropic.com > API keys. Server-only — never prefix with NEXT_PUBLIC_.
# Cost is roughly $0.01 per question: the site content (~6,700 tokens) is prompt-cached,
# so repeat questions read it at ~10% of normal input price. Rate limited to 12
# questions per IP per hour in src/app/api/ask/route.ts.
ANTHROPIC_API_KEY=
