    },
    {
      "t": "h3",
      "v": "contrast()"
    },
    {
      "t": "list",
      "ordered": false,
      "v": [
        "Adjusts the contrast of an element.",
        "Example:"
      ]
    },
    {
      "t": "code",
      "v": "filter: contrast(150%);"
    },
    {
      "t": "list",
      "ordered": false,
      "v": [
        "Improves readability of text over images."
      ]
    },
    {
