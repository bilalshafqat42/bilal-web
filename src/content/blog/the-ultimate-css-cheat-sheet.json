    },
    {
      "t": "p",
      "v": "CSS transform functions allow elements to be rotated, scaled, or moved."
    },
    {
      "t": "h3",
      "v": "rotate()"
    },
    {
      "t": "list",
      "ordered": false,
      "v": [
        "Rotates an element by a specified angle.",
        "Example:"
      ]
    },
    {
      "t": "code",
      "v": "transform: rotate(45deg);"
    },
    {
      "t": "h3",
